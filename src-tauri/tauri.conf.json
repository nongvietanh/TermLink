{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermLink",
  "version": "0.1.1",
  "identifier": "dev.termlink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TermLink",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b1020",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "TermLink",
    "category": "DeveloperTool",
    "shortDescription": "Remote access and server management workspace",
    "longDescription": "TermLink is a workspace for SSH terminals, connection profiles and server management.",
    "copyright": "Copyright (c) TermLink contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
